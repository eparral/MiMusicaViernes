
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detalle de canción"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginTop="35dp" />

    <TextView
        android:layout_width="100dp"
        android:layout_height="120dp"
        android:text="♫"
        android:textSize="80sp"
        android:gravity="center"
        android:textColor="#6750A4"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/txtDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre de canción"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:gravity="center" />

    <Button
        android:id="@+id/btnFavorito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Marcar favorita"
        android:backgroundTint="#6750A4"
        android:layout_marginTop="30dp" />

    <Button
        android:id="@+id/btnEscuchar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escuchar"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/btnEliminar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar canción"
        android:backgroundTint="#FF182C" />

    <Button
        android:id="@+id/btnVolverDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:backgroundTint="#6750A4" />

</LinearLayout>
